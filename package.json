{
  "name": "obs-shogi",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "tauri": "tauri",
    "dev": "vp dev",
    "build": "tsc -b && vp build",
    "lint": "vp lint .",
    "typecheck": "tsc -b",
    "test": "vp test run",
    "test:watch": "vp test watch",
    "verify": "npm run typecheck && npm run lint && npm test && npm run test:hooks",
    "test:hooks": "bash .claude/hooks/verify-gate.test.sh",
    "verify:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --all-features -- -D warnings && cargo test --manifest-path src-tauri/Cargo.toml --locked",
    "preview": "vp preview",
    "prepare": "vp config",
    "deadcode": "knip --include exports,types,files",
    "deadfiles": "knip --include files"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@lexical/list": "^0.41.0",
    "@lexical/markdown": "^0.41.0",
    "@lexical/react": "^0.41.0",
    "@lexical/rich-text": "^0.41.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "context": "^3.1.0",
    "json-kifu-format": "5.4.1",
    "lexical": "^0.41.0",
    "lucide-react": "^1.35.0",
    "path": "^0.12.7",
    "pathe": "^2.0.3",
    "prismjs": "^1.30.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.1",
    "react-window": "^2.3.0",
    "sass": "^1.103.1",
    "shogi.js": "5.4.1",
    "tsshogi": "^2.3.4",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.4.0",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "happy-dom": "^20.11.15",
    "knip": "^5.88.1",
    "postcss": "^8.5.26",
    "postcss-scss": "^4.0.9",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.68.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.1.24",
    "vite-plus": "0.1.24"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.1.24",
    "vitest": "npm:@voidzero-dev/vite-plus-test@0.1.24"
  },
  "packageManager": "npm@11.12.0"
}
