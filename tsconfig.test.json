{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "types": ["node"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  // vite-env.d.ts を入れないと、.tsx を辿るテストで `import "./x.scss"` が
  // TS2307 になる（noUncheckedSideEffectImports が効くため）。
  "include": [
    "src/vite-env.d.ts",
    "src/**/__tests__/**/*",
    "src/**/*.test.ts",
    "src/**/*.test.tsx"
  ],
  "exclude": []
}
