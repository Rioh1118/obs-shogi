{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "paths": {
      "@/*": ["./src/*"],
      // vitest は package.json の override 経由なので node_modules/vitest が無い。
      // ここを張らないとテストが丸ごと TS2307 になり、型検査から落ちる。
      "vitest": ["./node_modules/@voidzero-dev/vite-plus-test"]
    }
  },
  "include": ["src"],
  // テストは tsconfig.test.json が Node の型つきで検査する。ここに含めると、
  // TypeScript 7 で `types` の既定が `[]` になったため Node の型が無いまま検査され、
  // 走査テストの `node:fs` などが全て型エラーになる。WebView で動く本体には
  // Node の型を見せない
  "exclude": ["src/**/__tests__/**/*", "src/**/*.test.ts", "src/**/*.test.tsx"]
}
