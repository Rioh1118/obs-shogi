{
  "color": {
    "$type": "color",
    "$description": "色。テーマは1つ（墨・砂・銅。decisions/0005）。比は contrast-pairs.json で照合する",
    "background": {
      "sunken": {
        "$value": "{base.color.black}",
        "$description": "いちばん暗いサーフェス。上の帯、棋譜の見出しと手の移動の帯。ペインの本文には使わない"
      },
      "default": {
        "$value": "{base.color.dark}",
        "$description": "本文の背景。ペイン（サイドバー・棋譜・設定）は全部この1色にし、境目は線で引く（decisions/0004）"
      },
      "canvas": {
        "$value": "{base.color.light}",
        "$description": "持ち上げたサーフェス。いま見ているタブ、選ばれた区切りボタン"
      },
      "stage": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.1725,
            0.2118,
            0.2235
          ],
          "hex": "#2c3639"
        },
        "$description": "盤と駒台を置くサーフェス。墨から離した緑。利用者が 2026-11-21 に4色から選んだ（decisions/0005）"
      },
      "hover": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.1176,
            0.1529,
            0.1608
          ],
          "hex": "#1e2729"
        },
        "$description": "行のホバー"
      },
      "selected": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.1608,
            0.2078,
            0.2275
          ],
          "hex": "#29353a"
        },
        "$description": "選んだもの（ファイル・設定のタブ・適用中のプリセット）の灰青。銅は使わない（patterns/selection.md）"
      },
      "now": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.6902,
            0.4863,
            0.3333
          ],
          "hex": "#b07c55",
          "alpha": 0.15
        },
        "$description": "局面の「いま」（いまの手・最善手）の行。左の銅の線と組で使う（patterns/selection.md）"
      },
      "dock": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.1059,
            0.1373,
            0.1451
          ],
          "hex": "#1b2325"
        },
        "$description": "検討のドックの背景。ほかのペインより半段明るい（利用者が今のドックを選んだ。decisions/0005）"
      },
      "dock-strip": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.0863,
            0.1098,
            0.1176
          ],
          "hex": "#161c1e"
        },
        "$description": "検討のドックの見出しの帯"
      }
    },
    "surface": {
      "raised": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.1647,
            0.2,
            0.2118
          ],
          "hex": "#2a3336"
        },
        "$description": "暗い背景を1段階持ち上げたサーフェス。意味色を持たず「いま触れない」を示す（$surface-raised）"
      },
      "field": {
        "$value": "{base.color.black}",
